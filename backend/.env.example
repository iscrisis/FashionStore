APP_NAME=FashionStore API
APP_ENV=development
API_V1_PREFIX=/api/v1

# Formato: postgresql+psycopg://usuario:password@host:5432/database
# Local con Docker Compose: host = nombre del servicio (db)
# Local sin Docker: host = localhost
DATABASE_URL=postgresql+psycopg://fashionstore:changeme@localhost:5432/fashionstore

BACKEND_PORT=8000
FRONTEND_PORT=4200

# Orígenes permitidos separados por coma (sin espacios finales), ej:
# CORS_ORIGINS=http://localhost:4200,https://app.midominio.com
CORS_ORIGINS=http://localhost:4200

# Solo utilizadas por el servicio "db" en docker-compose.yml
POSTGRES_DB=fashionstore
POSTGRES_USER=fashionstore
POSTGRES_PASSWORD=changeme

# CU01 - Iniciar sesión. Generar un valor propio en cada entorno, ej:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-secret-in-every-environment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Administrador inicial (usado solo por scripts/seed_admin.py). Cambiar en producción.
ADMIN_INITIAL_NAME=Administrador FashionStore
ADMIN_INITIAL_EMAIL=admin@fashionstore.com
ADMIN_INITIAL_PASSWORD=changeme

# CU03 - Recuperar contraseña: SMTP real para enviar el enlace de
# restablecimiento (ver app/integrations/mailer.py). Con Gmail: activar
# verificación en 2 pasos y generar una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords -- NO usar la contraseña normal
# de la cuenta. Cualquier otro proveedor SMTP estándar también funciona.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-contraseña-de-aplicacion
MAIL_FROM=tu-correo@gmail.com

# Minutos de validez del enlace de recuperación antes de expirar.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# URL pública del frontend Angular. CU03 la usa para construir el enlace que
# se envía por correo -- en producción, la URL real de fashionstore-web en
# Vercel (nunca localhost).
FRONTEND_URL=http://localhost:4200

# CU08/CU09 - almacenamiento de imágenes en producción (ver app/core/image_storage.py).
# NO se usa en desarrollo local (ahí las imágenes se guardan en backend/uploads/).
# Solo hace falta en Vercel: crear un Blob Store en el proyecto de Vercel y
# conectarlo -- Vercel inyecta BLOB_READ_WRITE_TOKEN automáticamente como
# variable de entorno del proyecto, no hace falta copiarlo aquí.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
